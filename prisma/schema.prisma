// LIFEBridge MedTech — Business OS + GST + BI (Agent 3) — Supabase PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String   @id @default(cuid())
  legalName          String
  tradeName          String?
  companyType        String?
  pan                String?
  email              String?
  phone              String?
  address            String?  @db.Text
  city               String?
  state              String?
  stateCode          String?
  country            String   @default("IN")
  pincode            String?
  currency           String   @default("INR")
  financialYearStart Int      @default(4)
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  users              UserCompany[]
  customers          Customer[]
  products           Product[]
  auditLogs          AuditLog[]
  leads              Lead[]
  tenderSources      TenderSource[]
  enquiries          Enquiry[]
  messageDrafts      MessageDraft[]
  approvalRequests   ApprovalRequest[]
  webResearchRuns    WebResearchRun[]
  marketSignals      MarketSignal[]
  leadWatchlists     LeadWatchlist[]
  @@map("companies")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String?
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  companies    UserCompany[]
  sessions     Session[]
  auditLogs    AuditLog[]
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  isDefault Boolean  @default(false)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([userId, companyId])
  @@map("user_companies")
}

model Customer {
  id           String   @id @default(cuid())
  companyId    String
  customerCode String
  legalName    String
  tradeName    String?
  customerType String   @default("HOSPITAL")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId, customerCode])
  @@map("customers")
}

model Product {
  id        String   @id @default(cuid())
  companyId String
  sku       String
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId, sku])
  @@map("products")
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  company    Company? @relation(fields: [companyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
  @@map("audit_logs")
}

model TenderSource {
  id                  String    @id @default(cuid())
  companyId           String?
  name                String
  website             String?
  sourceType          String
  description         String?   @db.Text
  country             String    @default("IN")
  state               String?
  category            String?
  enabled             Boolean   @default(true)
  crawlAllowed        Boolean   @default(false)
  status              String    @default("HEALTHY")
  lastCheckedAt       DateTime?
  lastSuccessfulRunAt DateTime?
  lastError           String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  company             Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads               Lead[]
  evidence            LeadEvidence[]
  @@map("tender_sources")
}

model Lead {
  id                  String    @id @default(cuid())
  companyId           String
  organizationName    String
  title               String
  description         String?   @db.Text
  category            String?
  city                String?
  state               String?
  country             String    @default("IN")
  status              String    @default("DISCOVERED")
  confidence          String    @default("UNVERIFIED")
  opportunityScore    Int?
  recommendedAction   String?
  primarySourceUrl    String?   @db.Text
  tenderNumber        String?
  deadline            DateTime?
  estimatedValueMax   Decimal?  @db.Decimal(18, 2)
  sourceId            String?
  discoveredAt        DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source              TenderSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  evidence            LeadEvidence[]
  scores              LeadScore?
  contacts            LeadContact[]
  enquiries           Enquiry[]
  drafts              MessageDraft[]
  @@index([companyId, status])
  @@map("leads")
}

model LeadEvidence {
  id           String   @id @default(cuid())
  leadId       String
  sourceId     String?
  sourceUrl    String   @db.Text
  title        String?
  evidenceType String
  snippet      String?  @db.Text
  retrievedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  source       TenderSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  @@map("lead_evidence")
}

model LeadScore {
  id         String   @id @default(cuid())
  leadId     String   @unique
  totalScore Int
  explanation Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@map("lead_scores")
}

model LeadContact {
  id     String  @id @default(cuid())
  leadId String
  name   String?
  email  String?
  phone  String?
  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@map("lead_contacts")
}

model Enquiry {
  id        String   @id @default(cuid())
  companyId String
  leadId    String?
  source    String
  subject   String?
  message   String?  @db.Text
  status    String   @default("NEW")
  priority  String   @default("MEDIUM")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  drafts    MessageDraft[]
  @@map("enquiries")
}

model MessageDraft {
  id                String   @id @default(cuid())
  companyId         String
  leadId            String?
  enquiryId         String?
  channel           String
  subject           String?
  body              String   @db.Text
  status            String   @default("DRAFT")
  approvalRequestId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead              Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  enquiry           Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  @@map("message_drafts")
}

model ApprovalRequest {
  id           String    @id @default(cuid())
  companyId    String
  actionType   String
  draftContent String?   @db.Text
  channel      String?
  status       String    @default("PENDING")
  approvedBy   String?
  approvedAt   DateTime?
  rejectedBy   String?
  rejectedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drafts       MessageDraft[]
  @@map("approval_requests")
}

model WebResearchRun {
  id        String   @id @default(cuid())
  companyId String
  query     String   @db.Text
  status    String   @default("RUNNING")
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("web_research_runs")
}

model MarketSignal {
  id           String   @id @default(cuid())
  companyId    String
  organization String
  signalType   String
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("market_signals")
}

model LeadWatchlist {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("lead_watchlists")
}
