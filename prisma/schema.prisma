// LIFEBridge MedTech — Business OS + GST + BI (Agent 3) — Supabase PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                 String   @id @default(cuid())
  legalName          String
  tradeName          String?
  companyType        String?
  pan                String?
  email              String?
  phone              String?
  address            String?  @db.Text
  city               String?
  state              String?
  stateCode          String?
  country            String   @default("IN")
  pincode            String?
  currency           String   @default("INR")
  financialYearStart Int      @default(4)
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users             UserCompany[]
  customers         Customer[]
  products          Product[]
  auditLogs         AuditLog[]
  leads             Lead[]
  tenderSources     TenderSource[]
  enquiries         Enquiry[]
  messageDrafts     MessageDraft[]
  approvalRequests  ApprovalRequest[]
  webResearchRuns   WebResearchRun[]
  marketSignals     MarketSignal[]
  leadWatchlists    LeadWatchlist[]

  @@map("companies")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String?
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  companies    UserCompany[]
  sessions     Session[]
  auditLogs    AuditLog[]
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  isDefault Boolean  @default(false)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([userId, companyId])
  @@map("user_companies")
}

model Customer {
  id           String   @id @default(cuid())
  companyId    String
  customerCode String
  legalName    String
  tradeName    String?
  customerType String   @default("HOSPITAL")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId, customerCode])
  @@map("customers")
}

model Product {
  id        String   @id @default(cuid())
  companyId String
  sku       String
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId, sku])
  @@map("products")
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  company    Company? @relation(fields: [companyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
  @@map("audit_logs")
}

model TenderSource {
  id                  String    @id @default(cuid())
  companyId           String?
  name                String
  website             String?
  sourceType          String
  description         String?   @db.Text
  country             String    @default("IN")
  state               String?
  category            String?
  enabled             Boolean   @default(true)
  crawlAllowed        Boolean   @default(false)
  status              String    @default("HEALTHY")
  lastCheckedAt       DateTime?
  lastSuccessfulRunAt DateTime?
  lastError           String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  company             Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads               Lead[]
  evidence            LeadEvidence[]
  @@map("tender_sources")
}

model Lead {
  id                  String    @id @default(cuid())
  companyId           String
  customerId          String?
  organizationName    String
  legalName           String?
  organizationType    String?
  website             String?
  city                String?
  state               String?
  country             String    @default("IN")
  title               String
  description         String?   @db.Text
  category            String?
  relevance           String    @default("POSSIBLY_RELEVANT")
  estimatedValueMin   Decimal?  @db.Decimal(18, 2)
  estimatedValueMax   Decimal?  @db.Decimal(18, 2)
  currency            String    @default("INR")
  deadline            DateTime?
  tenderNumber        String?
  status              String    @default("DISCOVERED")
  confidence          String    @default("UNVERIFIED")
  opportunityScore    Int?
  businessFit         String?
  recommendedAction   String?
  sourceId            String?
  primarySourceUrl    String?   @db.Text
  isPossibleDuplicate Boolean   @default(false)
  discoveredAt        DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source              TenderSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  evidence            LeadEvidence[]
  scores              LeadScore?
  contacts            LeadContact[]
  enquiries           Enquiry[]
  drafts              MessageDraft[]
  @@index([companyId, status])
  @@index([companyId, opportunityScore])
  @@map("leads")
}

model LeadEvidence {
  id           String    @id @default(cuid())
  leadId       String
  sourceId     String?
  sourceUrl    String    @db.Text
  title        String?
  description  String?   @db.Text
  publishedAt  DateTime?
  retrievedAt  DateTime  @default(now())
  evidenceType String
  snippet      String?   @db.Text
  metadata     Json?
  createdAt    DateTime  @default(now())
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  source       TenderSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  @@index([leadId])
  @@map("lead_evidence")
}

model LeadScore {
  id                      String   @id @default(cuid())
  leadId                  String   @unique
  totalScore              Int
  sourceCredibility       Int      @default(0)
  healthcareRelevance     Int      @default(0)
  businessFitScore        Int      @default(0)
  opportunityValue        Int      @default(0)
  deadlineUrgency         Int      @default(0)
  organizationConfidence  Int      @default(0)
  contactAvailability     Int      @default(0)
  dataCompleteness        Int      @default(0)
  crossSourceConfirmation Int      @default(0)
  explanation             Json?
  calculatedAt            DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  lead                    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@map("lead_scores")
}

model LeadContact {
  id          String   @id @default(cuid())
  leadId      String
  name        String?
  designation String?
  email       String?
  phone       String?
  confidence  String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId])
  @@map("lead_contacts")
}

model Enquiry {
  id         String   @id @default(cuid())
  companyId  String
  leadId     String?
  source     String
  subject    String?
  message    String?  @db.Text
  receivedAt DateTime @default(now())
  status     String   @default("NEW")
  priority   String   @default("MEDIUM")
  intent     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  drafts     MessageDraft[]
  @@index([companyId, status])
  @@map("enquiries")
}

model MessageDraft {
  id                String   @id @default(cuid())
  companyId         String
  leadId            String?
  enquiryId         String?
  channel           String
  subject           String?
  body              String   @db.Text
  generatedBy       String?
  status            String   @default("DRAFT")
  approvalRequestId String?
  recipientEmail    String?
  recipientPhone    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead              Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  enquiry           Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  @@index([companyId, status])
  @@map("message_drafts")
}

model ApprovalRequest {
  id               String    @id @default(cuid())
  companyId        String
  requestedBy      String?
  actionType       String
  entityType       String?
  entityId         String?
  draftContent     String?   @db.Text
  channel          String?
  status           String    @default("PENDING")
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  rejectionReason  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drafts           MessageDraft[]
  @@index([companyId, status])
  @@map("approval_requests")
}

model WebResearchRun {
  id          String    @id @default(cuid())
  companyId   String
  userId      String?
  query       String    @db.Text
  parameters  Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("RUNNING")
  resultCount Int       @default(0)
  error       String?   @db.Text
  results     Json?
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("web_research_runs")
}

model MarketSignal {
  id           String   @id @default(cuid())
  companyId    String
  organization String
  signalType   String
  description  String?  @db.Text
  location     String?
  sourceUrl    String?  @db.Text
  confidence   String?
  detectedAt   DateTime @default(now())
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("market_signals")
}

model LeadWatchlist {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  name      String
  keywords  String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("lead_watchlists")
}
